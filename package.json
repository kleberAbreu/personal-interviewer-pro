{
  "name": "personal-interviewer-pro",
  "version": "0.0.0",
  "description": "Voice-first AI interview simulator with Gemini Live and OpenRouter text agents.",
  "type": "module",
  "bin": {
    "interview-pro": "./bin/interview-pro.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n broker,app -c cyan,magenta \"npm:dev:broker\" \"npm:dev:app\"",
    "dev:app": "vite",
    "dev:broker": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start": "node ./bin/interview-pro.mjs",
    "install:local": "bash ./scripts/install.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "@tailwindcss/vite": "^4.3.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  }
}
